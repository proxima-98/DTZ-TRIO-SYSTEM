function locationDetails(loc) {
  return (
    loc.emoji + " *" + loc.name + "*\n" +
    "_" + loc.full + "_\n\n" +
    loc.desc + "\n\n" +
    "📍 *Campus:* " + (loc.campus === "main" ? "Gidan Kwano (Main)" : "Bosso Campus") + "\n" +
    "🗺️ *Coords:* " + loc.coords + "\n\n" +
    "Type /dir\\_" + loc.id + " for directions"
  );
}

function directionsText(loc) {
  return (
    "🧭 *Directions to " + loc.name + "*\n" +
    "_" + loc.full + "_\n\n" +
    loc.directions + "\n\n" +
    "📍 *Campus:* " + (loc.campus === "main" ? "Gidan Kwano (Main)" : "Bosso Campus") + "\n" +
    "🗺️ *Coords:* " + loc.coords
  );
}

