bot.onText(/\/dir_(.+)/, (msg, match) => {
  const id = match[1].toLowerCase().trim();
  const loc = LOCATIONS.find(l => l.id === id);
  if (loc) {
    bot.sendMessage(msg.chat.id, directionsText(loc), menuKeyboard);
  } else {
    bot.sendMessage(msg.chat.id, "❓ Location not found. Try /find followed by the name.", menuKeyboard);
  }
});

bot.onText(/\/find (.+)/, (msg, match) => {
  const query = match[1].toLowerCase().trim();
  const results = LOCATIONS.filter(l =>
    l.name.toLowerCase().includes(query) ||
    l.full.toLowerCase().includes(query) ||
    l.id.includes(query) ||
    l.desc.toLowerCase().includes(query)
  );
  if (results.length === 0) {
    bot.sendMessage(msg.chat.id, "🤔 No results for *" + match[1] + "*. Try another keyword.", menuKeyboard);
  } else if (results.length === 1) {
    bot.sendMessage(msg.chat.id, locationDetails(results[0]), menuKeyboard);
  } else {
    let text = "🔍 *Results for " + match[1] + ":*\n\n";
    results.slice(0, 8).forEach(r => {
      text += r.emoji + " *" + r.name + "* — " + (r.campus === "main" ? "Main Campus" : "Bosso") + "\n";
    });
    text += "\nType the exact name for full details.";
    bot.sendMessage(msg.chat.id, text, menuKeyboard);
  }
});

bot.on("message", (msg) => {
  const text = msg.text || "";
  if (text.startsWith("/")) return;
  const skipButtons = ["🎓 Schools","🏥 Facilities","📌 Landmarks","🏛️ Administration","🗺️ Campus Info","ℹ️ About","❓ Help"];
  if (skipButtons.includes(text)) return;

  const query = text.toLowerCase().trim();
  const results = LOCATIONS.filter(l =>
    l.name.toLowerCase().includes(query) ||
    l.full.toLowerCase().includes(query) ||
    l.id.includes(query) ||
    l.desc.toLowerCase().includes(query)
  );

  if (results.length === 1) {
    bot.sendMessage(msg.chat.id, locationDetails(results[0]), menuKeyboard);
  } else if (results.length > 1) {
    let reply = "🔍 *Found " + results.length + " results for " + text + ":*\n\n";
    results.slice(0, 8).forEach(r => {
      reply += r.emoji + " *" + r.name + "* — " + (r.campus === "main" ? "Main Campus" : "Bosso") + "\n";
    });
    reply += "\nType the exact name for full details.";
    bot.sendMessage(msg.chat.id, reply, menuKeyboard);
  } else {
    bot.sendMessage(
      msg.chat.id,
      "🤔 I could not find *" + text + "* on campus.\n\nTry:\n• /schools\n• /facilities\n• /find [keyword]",
      menuKeyboard
    );
  }
});

